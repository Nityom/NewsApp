rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pushTokens/{tokenId} {
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
      // Spark-compatible push delivery: authenticated event creators query recipient tokens
      // and send through Expo Push Service directly because Cloud Functions require Blaze.
      allow read: if request.auth != null;
    }

    // MVP rules: any signed-in user (reporter or admin) can read/write.
    // Role separation (reporter vs admin) is currently only enforced in the app UI, not here.
    // Tighten this before going to production - e.g. restrict article status changes to admins only.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'pushTokens';
    }
  }
}
